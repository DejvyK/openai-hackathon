    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxjs": "7.8.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "1.1.5",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
