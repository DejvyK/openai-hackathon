# Copy to .env and launch with npm run dev (automatically loads this file).
# Default supports local pairing/extraction; v1 research/writes fail closed in demo mode.
AGENTLAYER_MODE=demo
# Optional. When empty, a random token is written to .pairing-token at startup.
AGENTLAYER_TOKEN=
# Live server-only configuration. Presence is not verified provider connectivity.
OPENAI_API_KEY=
OPENAI_MODEL=
EXA_API_KEY=
# Server-only CopilotKit Intelligence project key. Verified separately from presence.
COPILOTKIT_API_KEY=
COPILOTKIT_TELEMETRY_DISABLED=true
# Runtime SSE bridge is enabled by default; 0 opts out. Project key stays server-side.
COPILOTKIT_ENABLED=1
AMBIGUOUS_API_KEY=
# Local journal scope; confirm the tenant associated with this API key separately.
AMBIGUOUS_WORKSPACE_ID=
# LinkedIn goal research reuses OPENAI_API_KEY, OPENAI_MODEL, and EXA_API_KEY in live mode.
# Slack destination is server-owned; preview and explicit Send are required.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_TEAM_ID=
# Native MCP tools apply only to Codex children started by this project API.
# No global Codex MCP registration is created. Set 0 only for legacy rollback.
AGENTLAYER_MCP_ENABLED=1
# Google Calendar tools run through the existing CopilotKit / project MCP stack.
# Google Cloud OAuth web client; never put these credentials in the extension.
# Authorized redirect URI: http://127.0.0.1:4318/oauth/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
