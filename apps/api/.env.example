# Copy to .env and launch with npm run dev (automatically loads this file).
# Default is explicitly simulated; live integrations are not implemented yet.
AGENTLAYER_MODE=demo
# Optional. When empty, a random token is written to .pairing-token at startup.
AGENTLAYER_TOKEN=
# Future server-only integration configuration (unused by scaffold):
OPENAI_API_KEY=
EXA_API_KEY=
AMBIGUOUS_API_KEY=
